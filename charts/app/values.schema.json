{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["stack", "image"],
  "properties": {
    "stack": {
      "type": "object",
      "required": ["name", "namespace", "slo", "size"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,20}$" },
        "namespace": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["nonprod", "shared", "dedicated"] },
        "size": { "enum": ["tiny", "small", "medium"] },
        "slo": { "enum": ["99.9", "99.95"] }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "backup": {
      "type": "object",
      "properties": { "mode": { "enum": ["pgdump", "managed"] } }
    }
  }
}
