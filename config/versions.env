# Pinned versions — resolved 2026-10-25 from upstream release feeds
# (helm search repo, GitHub releases, registry.terraform.io, go.dev/dl).
# Every image/chart/provider/tool used by scripts and CI reads from here.

# Toolchain images (scripts/lib/tools.sh)
GO_VERSION=1.27.3
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot
TRIVY_VERSION=0.76.1
COSIGN_VERSION=3.1.4
CONFTEST_VERSION=0.71.1
KUBECONFORM_VERSION=0.8.0
TFLINT_VERSION=0.65.0
K6_VERSION=2.3.0
YQ_VERSION=4.54.1
JQ_VERSION=1.8.2
SHELLCHECK_VERSION=0.11.0
HELM_VERSION=4.3.1

# Cluster (kind 0.30.0 is the installed binary; node image from its release notes)
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a

# Data services
POSTGRES_MAJOR=18
POSTGRES_IMAGE=postgres:18.6-alpine
CNPG_POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6
VALKEY_IMAGE=valkey/valkey:9.1.2-alpine
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.96.0

# Observability (promtool in tests uses the same Prometheus as the cluster)
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0-distroless

# Helm charts
CHART_ARGOCD=10.11.1
CHART_ARGO_ROLLOUTS=2.43.8
CHART_TRAEFIK=42.1.3
CHART_KUBE_PROMETHEUS_STACK=92.13.1
CHART_PROMETHEUS_OPERATOR_CRDS=32.0.2
CHART_KEDA=2.21.0
CHART_EXTERNAL_SECRETS=2.14.0
CHART_METRICS_SERVER=3.14.0
CHART_CNPG=0.29.1
CHART_OPENBAO=0.30.4

# CI runner
ACTIONS_RUNNER_IMAGE=ghcr.io/actions/actions-runner:2.338.1

# Terraform providers / modules (also pinned in each versions.tf)
TF_PROVIDER_KIND=0.13.0
TF_PROVIDER_HELM=3.3.0
TF_PROVIDER_KUBERNETES=3.4.0
TF_PROVIDER_KUBECTL=2.4.1
TF_PROVIDER_VAULT=5.13.0
TF_PROVIDER_RANDOM=3.9.1
TF_PROVIDER_AWS=6.70.0
TF_MODULE_AWS_VPC=6.7.3
TF_MODULE_AWS_EKS=21.29.0
